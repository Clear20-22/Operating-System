#include <types.h>
#include <kern/errno.h>
#include <kern/unistd.h>
#include <kern/wait.h>
#include <kern/fcntl.h>
#include <kern/limits.h>
#include <lib.h>
#include <syscall.h>
#include <current.h>
#include <proc.h>
#include <thread.h>
#include <addrspace.h>
#include <copyinout.h>
#include <synch.h>
#include <vfs.h>
#include <vnode.h>
#include <mips/trapframe.h>

/*
 * exit() -- records exit status, wakes any waiting parent, and tears
 * down this process. If the process has a parent that might still
 * call waitpid(), the proc struct itself is kept alive (as a
 * "zombie") until the parent collects the status in sys_waitpid();
 * otherwise it is destroyed immediately.
 */
void
sys__exit(int exitcode)
{
        struct addrspace *as;
        struct proc *p = curproc;

        DEBUG(DB_SYSCALL,"Syscall: _exit(%d)\n",exitcode);

        KASSERT(curproc->p_addrspace != NULL);
        as_deactivate();
        as = curproc_setas(NULL);
        as_destroy(as);

        lock_acquire(p->proc_lock);
        p->exit_status = exitcode;
        p->exited = true;
        cv_broadcast(p->exit_cv, p->proc_lock);
        lock_release(p->proc_lock);

        proc_orphan_children(p);

        /* detach this thread from its process; curproc is invalid after this */
        proc_remthread(curthread);

        if (p->parent == NULL) {
                /* no parent to reap us -- safe to destroy now */
                proc_destroy(p);
        }
        /* else: leave p alive as a zombie; sys_waitpid() destroys it later */

        thread_exit();
        panic("return from thread_exit in sys__exit\n");
}

/*
 * getpid() -- trivial once proc->pid is populated.
 */
int
sys_getpid(pid_t *retval)
{
        KASSERT(curproc != NULL);
        *retval = curproc->pid;
        return 0;
}

/*
 * waitpid() -- blocks until the named child has exited, then collects
 * its exit status and reaps (destroys) the zombie proc struct.
 */
int
sys_waitpid(pid_t pid,
            userptr_t status,
            int options,
            pid_t *retval)
{
        struct proc *child;
        int exitstatus;
        int result;

        if (options != 0) {
                return EINVAL;
        }

        child = proc_lookup_pid(pid);
        if (child == NULL) {
                return ESRCH;
        }

        if (child->parent != curproc) {
                return ECHILD;
        }

        lock_acquire(child->proc_lock);
        while (!child->exited) {
                cv_wait(child->exit_cv, child->proc_lock);
        }
        exitstatus = child->exit_status;
        lock_release(child->proc_lock);

        if (status != NULL) {
                result = copyout((void *)&exitstatus, status, sizeof(int));
                if (result) {
                        return result;
                }
        }

        *retval = pid;

        /* status has been collected; safe to reap the zombie now */
        proc_destroy(child);

        return 0;
}

/*
 * fork() -- duplicates the calling process. The parent returns
 * normally from sys_fork with the child's pid; the child is started
 * via thread_fork(), and re-enters user mode through
 * enter_forked_process() (see syscall.c) with v0=0.
 */

static
void
fork_forkentry(void *data1, unsigned long data2)
{
        (void)data2;
        enter_forked_process((struct trapframe *)data1);
        /* does not return */
}

int
sys_fork(struct trapframe *tf, pid_t *retval)
{
        struct proc *child;
        struct trapframe *child_tf;
        int result;

        child = proc_create_runprogram(curproc->p_name);
        if (child == NULL) {
                return ENOMEM;
        }

        /* proc_create_runprogram() already sets child->parent/ppid
           from curproc, and allocates a fresh pid */

        result = as_copy(curproc_getas(), &child->p_addrspace);
        if (result) {
                proc_destroy(child);
                return result;
        }

        child_tf = kmalloc(sizeof(struct trapframe));
        if (child_tf == NULL) {
                proc_destroy(child);
                return ENOMEM;
        }
        *child_tf = *tf;

        result = thread_fork("child process", child,
                              fork_forkentry, child_tf, 0);
        if (result) {
                kfree(child_tf);
                proc_destroy(child);
                return result;
        }

        *retval = child->pid;
        return 0;
}

/*
 * execv() -- replaces the current process's address space with a
 * freshly loaded executable. Copies progname and argv in from user
 * space, loads the ELF, sets up the new stack with argv, and enters
 * user mode. Does not return on success.
 */
int
sys_execv(const char *progname, char **args)
{
        struct addrspace *as, *old_as;
        struct vnode *v;
        vaddr_t entrypoint, stackptr;
        int result;
        char kprogname[PATH_MAX];
        size_t got;

        int argc;
        char *kargs[64];
        char kbuf[ARG_MAX];
        size_t bufpos = 0;
        vaddr_t arg_ptrs[65];
        int i;

        if (progname == NULL || args == NULL) {
                return EFAULT;
        }

        result = copyinstr((const_userptr_t)progname, kprogname,
                            sizeof(kprogname), &got);
        if (result) {
                return result;
        }

        for (argc = 0; argc < 63; argc++) {
                char *uarg;
                size_t arglen;

                result = copyin((const_userptr_t)&args[argc], &uarg, sizeof(char *));
                if (result) {
                        return result;
                }
                if (uarg == NULL) {
                        break;
                }
                if (bufpos >= sizeof(kbuf)) {
                        return E2BIG;
                }
                kargs[argc] = &kbuf[bufpos];
                result = copyinstr((const_userptr_t)uarg, &kbuf[bufpos],
                                    sizeof(kbuf) - bufpos, &arglen);
                if (result) {
                        return result;
                }
                bufpos += arglen;
        }
        kargs[argc] = NULL;

        result = vfs_open(kprogname, O_RDONLY, 0, &v);
        if (result) {
                return result;
        }

        old_as = curproc_getas();

        as = as_create();
        if (as == NULL) {
                vfs_close(v);
                return ENOMEM;
        }

        curproc_setas(as);
        as_activate();

        result = load_elf(v, &entrypoint);
        if (result) {
                vfs_close(v);
                curproc_setas(old_as);
                as_activate();
                as_destroy(as);
                return result;
        }

        vfs_close(v);

        result = as_define_stack(as, &stackptr);
        if (result) {
                curproc_setas(old_as);
                as_activate();
                as_destroy(as);
                return result;
        }

        for (i = argc - 1; i >= 0; i--) {
                size_t len = strlen(kargs[i]) + 1;
                stackptr -= len;
                stackptr -= stackptr % 4;
                result = copyout(kargs[i], (userptr_t)stackptr, len);
                if (result) {
                        as_destroy(as);
                        return result;
                }
                arg_ptrs[i] = stackptr;
        }
        arg_ptrs[argc] = 0;

        stackptr -= (argc + 1) * sizeof(vaddr_t);
        stackptr -= stackptr % 8;
        result = copyout(arg_ptrs, (userptr_t)stackptr,
                          (argc + 1) * sizeof(vaddr_t));
        if (result) {
                as_destroy(as);
                return result;
        }

        as_destroy(old_as);

        enter_new_process(argc, (userptr_t)stackptr, stackptr, entrypoint);
        /* does not return */

        panic("enter_new_process returned in sys_execv\n");
        return EINVAL;
}
