/*
 * Process support.
 *
 * p_lock is intended to be held when manipulating the pointers in the
 * proc structure, not while doing any significant work with the
 * things they point to.
 *
 * ASST2: added pid allocation/lookup, and exit/wait bookkeeping fields
 * (pid, ppid, parent, exit_cv, proc_lock, exit_status, exited) matching
 * the declarations added to proc.h.
 */

#include <types.h>
#include <proc.h>
#include <current.h>
#include <addrspace.h>
#include <vnode.h>
#include <vfs.h>
#include <synch.h>
#include <kern/fcntl.h>
#include <test.h>
#include <kern/errno.h>
#include <limits.h>

/*
 * The process for the kernel; this holds all the kernel-only threads.
 */
struct proc *kproc;

/* pid table: pid_table[pid] == NULL means free, == (struct proc*)1 means
 * reserved-but-not-yet-installed, otherwise points at the live proc. */
static struct proc *pid_table[MAX_PROC];
static struct lock *pid_lock;
static pid_t next_pid = PID_MIN;

/*
 * Mechanism for making the kernel menu thread sleep while processes are running
 */
#ifdef UW
static volatile unsigned int proc_count;
static struct semaphore *proc_count_mutex;
struct semaphore *no_proc_sem;
#endif  // UW

/*
 * ---- PID management ----
 */

int
pid_alloc(pid_t *retval)
{
        int i;
        pid_t start;
        pid_t candidate;

        KASSERT(pid_lock != NULL);
        lock_acquire(pid_lock);

        start = next_pid;
        for (i = 0; i < MAX_PROC; i++) {
                candidate = start + i;
                if (candidate >= MAX_PROC) {
                        candidate = PID_MIN + (candidate - MAX_PROC);
                }
                if (pid_table[candidate] == NULL) {
                        pid_table[candidate] = (struct proc *)1; /* reserve */
                        next_pid = candidate + 1;
                        if (next_pid >= MAX_PROC) {
                                next_pid = PID_MIN;
                        }
                        lock_release(pid_lock);
                        *retval = candidate;
                        return 0;
                }
        }

        lock_release(pid_lock);
        return ENPROC;
}

static
void
pid_table_set(pid_t pid, struct proc *proc)
{
        KASSERT(pid >= 0 && pid < MAX_PROC);
        lock_acquire(pid_lock);
        pid_table[pid] = proc;
        lock_release(pid_lock);
}

void
pid_dealloc(pid_t pid)
{
        KASSERT(pid >= 0 && pid < MAX_PROC);
        lock_acquire(pid_lock);
        pid_table[pid] = NULL;
        lock_release(pid_lock);
}

struct proc *
proc_lookup_pid(pid_t pid)
{
        struct proc *p;

        if (pid < 0 || pid >= MAX_PROC) {
                return NULL;
        }
        lock_acquire(pid_lock);
        p = pid_table[pid];
        lock_release(pid_lock);
        if (p == (struct proc *)1) {
                return NULL; /* reserved but not fully created */
        }
        return p;
}

/*
 * Clear the parent pointer of any children of p. Called when p exits,
 * so that orphaned children self-destroy on their own exit instead of
 * becoming permanent zombies that nobody will ever waitpid() on.
 */
void
proc_orphan_children(struct proc *p)
{
        int i;

        KASSERT(pid_lock != NULL);
        lock_acquire(pid_lock);
        for (i = 0; i < MAX_PROC; i++) {
                if (pid_table[i] != NULL && pid_table[i] != (struct proc *)1
                    && pid_table[i]->parent == p) {
                        pid_table[i]->parent = NULL;
                }
        }
        lock_release(pid_lock);
}

/*
 * Create a proc structure.
 */
static
struct proc *
proc_create(const char *name)
{
        struct proc *proc;

        proc = kmalloc(sizeof(*proc));
        if (proc == NULL) {
                return NULL;
        }
        proc->p_name = kstrdup(name);
        if (proc->p_name == NULL) {
                kfree(proc);
                return NULL;
        }

        threadarray_init(&proc->p_threads);
        spinlock_init(&proc->p_lock);

        /* VM fields */
        proc->p_addrspace = NULL;

        /* VFS fields */
        proc->p_cwd = NULL;

#ifdef UW
        proc->console = NULL;
#endif // UW

        /* ASST2 fields */
        proc->pid = 0;
        proc->ppid = 0;
        proc->parent = NULL;
        proc->exit_status = 0;
        proc->exited = false;

        proc->exit_cv = cv_create(name);
        if (proc->exit_cv == NULL) {
                spinlock_cleanup(&proc->p_lock);
                threadarray_cleanup(&proc->p_threads);
                kfree(proc->p_name);
                kfree(proc);
                return NULL;
        }

        proc->proc_lock = lock_create(name);
        if (proc->proc_lock == NULL) {
                cv_destroy(proc->exit_cv);
                spinlock_cleanup(&proc->p_lock);
                threadarray_cleanup(&proc->p_threads);
                kfree(proc->p_name);
                kfree(proc);
                return NULL;
        }

        return proc;
}

/*
 * Destroy a proc structure.
 */
void
proc_destroy(struct proc *proc)
{
        KASSERT(proc != NULL);
        KASSERT(proc != kproc);

        /* VFS fields */
        if (proc->p_cwd) {
                VOP_DECREF(proc->p_cwd);
                proc->p_cwd = NULL;
        }

#ifndef UW  // in the UW version, space destruction occurs in sys_exit, not here
        if (proc->p_addrspace) {
                struct addrspace *as;
                as_deactivate();
                as = curproc_setas(NULL);
                as_destroy(as);
        }
#endif // UW

#ifdef UW
        if (proc->console) {
          vfs_close(proc->console);
        }
#endif // UW

        threadarray_cleanup(&proc->p_threads);
        spinlock_cleanup(&proc->p_lock);

        lock_destroy(proc->proc_lock);
        cv_destroy(proc->exit_cv);

        if (proc->pid != 0) {
                pid_dealloc(proc->pid);
        }

        kfree(proc->p_name);
        kfree(proc);

#ifdef UW
        P(proc_count_mutex);
        KASSERT(proc_count > 0);
        proc_count--;
        if (proc_count == 0) {
          V(no_proc_sem);
        }
        V(proc_count_mutex);
#endif // UW
}

/*
 * Create the process structure for the kernel.
 */
void
proc_bootstrap(void)
{
  int i;

  kproc = proc_create("[kernel]");
  if (kproc == NULL) {
    panic("proc_create for kproc failed\n");
  }

  pid_lock = lock_create("pid_lock");
  if (pid_lock == NULL) {
    panic("could not create pid_lock\n");
  }

  for (i = 0; i < MAX_PROC; i++) {
    pid_table[i] = NULL;
  }

#ifdef UW
  proc_count = 0;
  proc_count_mutex = sem_create("proc_count_mutex",1);
  if (proc_count_mutex == NULL) {
    panic("could not create proc_count_mutex semaphore\n");
  }
  no_proc_sem = sem_create("no_proc_sem",0);
  if (no_proc_sem == NULL) {
    panic("could not create no_proc_sem semaphore\n");
  }
#endif // UW
}

/*
 * Create a fresh proc for use by runprogram.
 *
 * It will have no address space and will inherit the current
 * process's (that is, the kernel menu's) current directory.
 */
struct proc *
proc_create_runprogram(const char *name)
{
        struct proc *proc;
        char *console_path;
        pid_t new_pid;
        int result;

        proc = proc_create(name);
        if (proc == NULL) {
                return NULL;
        }

        result = pid_alloc(&new_pid);
        if (result) {
                proc_destroy(proc);
                return NULL;
        }
        proc->pid = new_pid;
        pid_table_set(new_pid, proc);

        if (curproc != NULL) {
                proc->ppid = curproc->pid;
                proc->parent = curproc;
        }

#ifdef UW
        /* open the console - this should always succeed */
        console_path = kstrdup("con:");
        if (console_path == NULL) {
          panic("unable to copy console path name during process creation\n");
        }
        if (vfs_open(console_path,O_WRONLY,0,&(proc->console))) {
          panic("unable to open the console during process creation\n");
        }
        kfree(console_path);
#endif // UW

        /* VM fields */
        proc->p_addrspace = NULL;

        /* VFS fields */
#ifdef UW
        if (curproc->p_cwd != NULL) {
                VOP_INCREF(curproc->p_cwd);
                proc->p_cwd = curproc->p_cwd;
        }
#else // UW
        spinlock_acquire(&curproc->p_lock);
        if (curproc->p_cwd != NULL) {
                VOP_INCREF(curproc->p_cwd);
                proc->p_cwd = curproc->p_cwd;
        }
        spinlock_release(&curproc->p_lock);
#endif // UW

#ifdef UW
        P(proc_count_mutex);
        proc_count++;
        V(proc_count_mutex);
#endif // UW

        return proc;
}

/*
 * Add a thread to a process. Either the thread or the process might
 * or might not be current.
 */
int
proc_addthread(struct proc *proc, struct thread *t)
{
        int result;

        KASSERT(t->t_proc == NULL);

        spinlock_acquire(&proc->p_lock);
        result = threadarray_add(&proc->p_threads, t, NULL);
        spinlock_release(&proc->p_lock);
        if (result) {
                return result;
        }
        t->t_proc = proc;
        return 0;
}

/*
 * Remove a thread from its process. Either the thread or the process
 * might or might not be current.
 */
void
proc_remthread(struct thread *t)
{
        struct proc *proc;
        unsigned i, num;

        proc = t->t_proc;
        KASSERT(proc != NULL);

        spinlock_acquire(&proc->p_lock);
        num = threadarray_num(&proc->p_threads);
        for (i=0; i<num; i++) {
                if (threadarray_get(&proc->p_threads, i) == t) {
                        threadarray_remove(&proc->p_threads, i);
                        spinlock_release(&proc->p_lock);
                        t->t_proc = NULL;
                        return;
                }
        }
        spinlock_release(&proc->p_lock);
        panic("Thread (%p) has escaped from its process (%p)\n", t, proc);
}

/*
 * Fetch the address space of the current process.
 */
struct addrspace *
curproc_getas(void)
{
        struct addrspace *as;
#ifdef UW
        if (curproc == NULL) {
                return NULL;
        }
#endif
        spinlock_acquire(&curproc->p_lock);
        as = curproc->p_addrspace;
        spinlock_release(&curproc->p_lock);
        return as;
}

/*
 * Change the address space of the current process, and return the old one.
 */
struct addrspace *
curproc_setas(struct addrspace *newas)
{
        struct addrspace *oldas;
        struct proc *proc = curproc;

        spinlock_acquire(&proc->p_lock);
        oldas = proc->p_addrspace;
        proc->p_addrspace = newas;
        spinlock_release(&proc->p_lock);
        return oldas;
}

/*
 * Simple self-contained test of pid_alloc/pid_dealloc/proc_lookup_pid,
 * runnable from the kernel menu as "pt", independent of fork/execv.
 */
int
pidtest(int nargs, char **args)
{
        (void)nargs;
        (void)args;

        pid_t p1, p2, p3;
        int result;

        kprintf("Starting pid test...\n");

        result = pid_alloc(&p1);
        KASSERT(result == 0);
        kprintf("Allocated pid %d\n", p1);

        result = pid_alloc(&p2);
        KASSERT(result == 0);
        kprintf("Allocated pid %d\n", p2);

        KASSERT(p1 != p2);

        pid_dealloc(p1);
        kprintf("Deallocated pid %d\n", p1);

        KASSERT(proc_lookup_pid(p1) == NULL);
        kprintf("Confirmed pid %d is free after dealloc\n", p1);

        result = pid_alloc(&p3);
        KASSERT(result == 0);
        kprintf("Allocated pid %d (may reuse %d)\n", p3, p1);

        pid_dealloc(p2);
        pid_dealloc(p3);

        kprintf("pid test done.\n");
        return 0;
}
